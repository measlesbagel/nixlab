// Tailnet policy for the homelab. Applied by .github/workflows/tailscale-policy.yml
// on merge to main; PRs run the `tests` blocks below against it.
//
// Identity model: hosts and CI are tagged (never person-owned), people are
// reached through autogroup:admin. No e-mail addresses live in this file.
{
	"tagOwners": {
		// The provisioning OAuth client's only tag. It is never put on a
		// device; it owns the tags provision mints single-use join keys for.
		"tag:molt": ["autogroup:admin"],

		"tag:typhochlaena": ["autogroup:admin", "tag:molt"], // lab
		"tag:hapalotremus": ["autogroup:admin", "tag:molt"], // nas
		"tag:homoeomma": ["autogroup:admin", "tag:molt"], // workstations
		"tag:cyriocosmus": ["autogroup:admin", "tag:molt"], // DGX Sparks
		// Temporary kexec installers made by `nix run .#provision`.
		"tag:instar": ["autogroup:admin", "tag:molt"],
	},

	// Network reachability. Anything not granted here is denied.
	"grants": [
		// Admins reach every host on every port.
		{"src": ["autogroup:admin"], "dst": ["tag:typhochlaena", "tag:hapalotremus", "tag:homoeomma", "tag:cyriocosmus"], "ip": ["*"]},

		// The break-glass deploy desktop only needs SSH (Tailscale SSH on :22).
		{"src": ["tag:homoeomma"], "dst": ["tag:typhochlaena", "tag:hapalotremus", "tag:homoeomma", "tag:cyriocosmus"], "ip": ["tcp:22"]},

		// Whoever provisions (an admin, chilense) reaches the installer.
		{"src": ["tag:homoeomma", "autogroup:admin"], "dst": ["tag:instar"], "ip": ["tcp:22"]},

		// albipes pulls ZFS replicas from seladonia and chilense over SSH.
		{"src": ["tag:hapalotremus"], "dst": ["tag:typhochlaena", "tag:homoeomma"], "ip": ["tcp:22"]},
	],

	// Tailscale SSH: who may log in as which local user.
	"ssh": [
		{
			"action": "accept",
			"src":    ["tag:homoeomma", "autogroup:admin"],
			"dst":    ["tag:typhochlaena", "tag:hapalotremus", "tag:homoeomma", "tag:cyriocosmus"],
			"users":  ["deploy"],
		},
		{
			"action": "accept",
			"src":    ["tag:hapalotremus"],
			"dst":    ["tag:typhochlaena", "tag:homoeomma"],
			"users":  ["syncoid"],
		},
		{
			"action": "accept",
			"src":    ["autogroup:admin"],
			"dst":    ["tag:typhochlaena", "tag:hapalotremus", "tag:homoeomma", "tag:cyriocosmus"],
			"users":  ["measles"],
		},
		{
			"action": "accept",
			"src":    ["tag:homoeomma", "autogroup:admin"],
			"dst":    ["tag:instar"],
			"users":  ["root"],
		},
	],

	"tests": [
		{
			"src":    "tag:cyriocosmus",
			"deny":   ["tag:typhochlaena:22", "tag:hapalotremus:22", "tag:homoeomma:22", "tag:hapalotremus:7313"],
		},
		{
			"src":    "tag:homoeomma",
			"accept": ["tag:typhochlaena:22", "tag:hapalotremus:22", "tag:cyriocosmus:22"],
			"deny":   ["tag:typhochlaena:5432", "tag:hapalotremus:2049", "tag:hapalotremus:9000", "tag:hapalotremus:7313"],
		},
		{
			"src":    "tag:hapalotremus",
			"accept": ["tag:typhochlaena:22", "tag:homoeomma:22"],
			"deny":   ["tag:typhochlaena:5432", "tag:homoeomma:5432"],
		},
		{
			"src":    "tag:typhochlaena",
			"deny":   ["tag:hapalotremus:22", "tag:homoeomma:22", "tag:instar:22"],
		},
		{
			"src":    "tag:instar",
			"deny":   ["tag:typhochlaena:22", "tag:hapalotremus:22", "tag:homoeomma:22"],
		},
	],

	"sshTests": [
		{
			"src":    "tag:homoeomma",
			"dst":    ["tag:instar"],
			"accept": ["root"],
		},
		{
			"src":    "tag:hapalotremus",
			"dst":    ["tag:instar"],
			"deny":   ["root"],
		},
		{
			"src":    "tag:homoeomma",
			"dst":    ["tag:typhochlaena", "tag:hapalotremus", "tag:cyriocosmus"],
			"accept": ["deploy"],
			"deny":   ["root", "syncoid", "measles"],
		},
		{
			"src":    "tag:hapalotremus",
			"dst":    ["tag:typhochlaena", "tag:homoeomma"],
			"accept": ["syncoid"],
			"deny":   ["deploy", "root"],
		},
		{
			"src":    "tag:typhochlaena",
			"dst":    ["tag:hapalotremus"],
			"deny":   ["deploy", "root", "syncoid"],
		},
	],
}
